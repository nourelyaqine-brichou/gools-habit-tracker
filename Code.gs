// GOOLS sync backend — Google Apps Script
// Creates a single private-data record in the spreadsheet attached to this script.
const SHEET_NAME = 'GOOLS_DATA';
function setup(){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh)sh=ss.insertSheet(SHEET_NAME);sh.getRange(1,1,1,2).setValues([['key','json']]);return 'Ready';}
function doGet(e){const action=(e.parameter&&e.parameter.action)||'load';let payload={ok:true,data:null};try{const sh=getSheet_();if(action==='load'){const raw=sh.getRange(2,2).getDisplayValue();payload.data=raw?JSON.parse(raw):null;}}catch(err){payload={ok:false,error:String(err)}}const json=JSON.stringify(payload);const cb=e.parameter&&e.parameter.callback;if(cb&&/^[A-Za-z0-9_$]+$/.test(cb))return ContentService.createTextOutput(cb+'('+json+')').setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);}
function doPost(e){try{const body=e.postData&&e.postData.contents?JSON.parse(e.postData.contents):{};const data=body.data||body;const sh=getSheet_();sh.getRange(2,1,1,2).setValues([['data',JSON.stringify(data)]]);return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err)})).setMimeType(ContentService.MimeType.JSON)}}
function getSheet_(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('Create this script from Extensions > Apps Script in your Google Sheet.');let sh=ss.getSheetByName(SHEET_NAME);if(!sh){sh=ss.insertSheet(SHEET_NAME);sh.getRange(1,1,1,2).setValues([['key','json']]);}return sh;}
